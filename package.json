{
  "name": "meet-side-service",
  "version": "0.2.0",
  "private": true,
  "description": "Sidecar that consumes user settings update messages from RabbitMQ and applies them to Meet's PostgreSQL database",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --import ./dist/instrument.js dist/main.js",
    "dev": "tsx watch --import ./src/instrument.ts src/main.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.spec.ts'",
    "test:integration": "vitest run .integration.spec.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@linagora/rabbitmq-client": "^0.7.1",
    "@sentry/node": "^10.75.3",
    "amqplib": "^0.10.9",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "pino": "^9.5.0",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@testcontainers/rabbitmq": "^12.1.0",
    "@types/amqplib": "^0.10.8",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "testcontainers": "^12.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.2"
  }
}
